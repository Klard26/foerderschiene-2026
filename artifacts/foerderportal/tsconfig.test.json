{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**/*.ts",
    "src/test/**/*.tsx"
  ],
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": ".test.tsbuildinfo",
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"]
  }
}