    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@clerk/express": "^2.1.15",
    "@clerk/shared": "^4.10.2",
    "@google-cloud/storage": "^7.19.0",
    "@replit/connectors-sdk": "^0.4.2",
    "@swc/helpers": "^0.5.21",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/energie-calc": "workspace:*",
    "@workspace/energie-wechsel": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.5.1",
    "google-auth-library": "^10.6.2",
    "http-proxy-middleware": "^4.0.0",
    "node-ical": "^0.26.1",
    "pdfkit": "^0.18.0",
